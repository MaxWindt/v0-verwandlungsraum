# Postgres connection string (Neon via the Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/verwandlungsraum
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Vercel Blob token (set automatically when you connect a Blob store on Vercel). Leave empty locally.
BLOB_READ_WRITE_TOKEN=
# Cloudflare deploy hook that rebuilds the website (see README.md)
DEPLOY_HOOK_URL=
# Optional: the expiry scheduler Worker (see ../scheduler/README.md). Without it, expired events are
# still hidden in the browser, they just stay in the static HTML until the next rebuild.
SCHEDULER_URL=
SCHEDULER_SECRET=
# Public website, used for the live preview and the "Preview" buttons in the admin
SITE_URL=http://localhost:3000
